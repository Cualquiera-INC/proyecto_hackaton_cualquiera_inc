# Construye el frontend y lo sirve con NGINX junto al proxy hacia app1/app2.
FROM node:22-alpine AS frontend
WORKDIR /src
COPY frontend-nodo/package.json frontend-nodo/package-lock.json ./
RUN npm ci
COPY frontend-nodo/ ./
# Mismo origen detrás del proxy: rutas relativas /pedidos y /health
ENV VITE_API_URL=
RUN npm run build

FROM nginx:1.28-alpine
COPY ayuda_opcional/nginx.conf /etc/nginx/nginx.conf
COPY --from=frontend /src/dist /usr/share/nginx/html
EXPOSE 80
